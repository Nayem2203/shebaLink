            "type": "integer"
          },
          "pending_bookings": {
            "title": "Pending Bookings",
            "type": "integer"
          },
          "total_bookings": {
            "title": "Total Bookings",
            "type": "integer"
          },
          "total_categories": {
            "title": "Total Categories",
            "type": "integer"
          },
          "total_providers": {
            "title": "Total Providers",
            "type": "integer"
          },
          "total_revenue_bdt": {
            "title": "Total Revenue Bdt",
            "type": "integer"
          },
          "total_reviews": {
            "title": "Total Reviews",
            "type": "integer"
          },
          "verified_providers": {
            "title": "Verified Providers",
            "type": "integer"
          }
        },
        "required": [
          "total_categories",
